---
import ThreeBasic from '../../components/ThreeJS/threeBasic.astro';
import Layout from '../../layouts/Layout.astro';

---
<Layout title="Three.js • Aramis Jones" description="Three.js demo" consoleMessage="Woah! who's this cool guy?">
  <section class="flex flex-col items-center">
    <canvas class="webgl"></canvas>

    <section class="section">
        <h1>My Portfolio</h1>
    </section>
    <section class="section">
        <h2>My projects</h2>
    </section>
    <section class="section">
        <h2>Contact me</h2>
    </section>


    <script src="../../components/ThreeJS/scroll.ts"></script>
  </section>
</Layout>

<style>
  *
    {
        margin: 0;
        padding: 0;
    }

    html,
    body
    {
        overflow-x: hidden;
    }

    .webgl
    {
        position: fixed;
        top: 0;
        left: 0;
        outline: none;
        z-index: 0;
        pointer-events: none;
    }


    .section
    {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        width: 100%;
        height: 100vh;
        position: relative;
        z-index: 1;
        font-family: 'Cabin', sans-serif;
        color: #ffeded;
        text-transform: uppercase;
        font-size: 7vmin;
        padding-left: 10%;
        padding-right: 10%;
    }

    section:nth-child(odd)
    {
        justify-content: flex-end;
    }
</style>