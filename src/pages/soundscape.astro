---
import Layout from '../layouts/Layout.astro';
import '../components/Soundscape/soundscape.css';
---

<Layout
  title="Soundscape — Aramis Jones"
  description="Describe a scene and find the sounds that belong in it. Music by migfus20 from OpenGameArt.org."
>
  <section class="soundscape" data-soundscape>
    <div class="soundscape__surface">
      <div class="soundscape__status" data-soundscape-status aria-live="polite"></div>
      <p class="soundscape__credit">
        Music by <a href="https://opengameart.org/users/migfus20" target="_blank" rel="noreferrer">migfus20</a>
        via <a href="https://opengameart.org/" target="_blank" rel="noreferrer">OpenGameArt.org</a>
      </p>
    </div>
    <aside class="soundscape__master-volume" aria-label="Master volume">
      <label for="soundscape-master-volume">Master volume</label>
      <div class="soundscape__master-volume-row">
        <input id="soundscape-master-volume" data-master-volume type="range" min="0" max="100" step="1" value="70" />
        <output data-master-volume-output for="soundscape-master-volume">70%</output>
      </div>
    </aside>
    <details class="soundscape__info">
      <summary aria-label="Soundscape instructions">i</summary>
      <div class="soundscape__info-tooltip" role="tooltip">
        Type a scene name to shape the mix. Click a sound to remove it, or drag sounds under the bar to add them.
      </div>
    </details>
  </section>
</Layout>
<script src="../scripts/soundscape.ts"></script>
