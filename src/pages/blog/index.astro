---
import BlogLayout from '../../layouts/BlogLayout.astro';

interface BlogPost {
	title: string;
	description: string;
	slug: string;
	date?: string;
}

const blogPosts: BlogPost[] = [
	{
		title: 'Snowfall Canvas',
		description: 'Canvas snow that accumulates on page elements',
		slug: '/blog/snowfall-canvas',
	},
	{
		title: 'Rainfall Canvas',
		description: 'Canvas rain with splash effects on page elements',
		slug: '/blog/rainfall-canvas',
	},
	{
		title: 'Fuzzy Searches',
		description: 'Contains, Hamming, Levenshtein, and friends',
		slug: '/blog/fuzzy-search',
	},
	{
		title: 'Gradients',
		description: 'Linear, radial, and conic, with a playground',
		slug: '/blog/gradients',
	},
	{
		title: '3D Effect with CSS',
		description: 'Perspective and transforms for depth in CSS',
		slug: '/blog/3d-css',
	},
	{
		title: 'Floating Image Effect',
		description: 'A light CSS and JS floating image',
		slug: '/blog/floating-image',
	},
];
---

<BlogLayout title="Blog" description="Notes on animation, CSS, and search">
	<div class="blog-page">
		<div class="blog">
			<header class="blog-header">
				<p class="blog-label">Blog</p>
				<p class="blog-intro">Notes on animation, CSS, and search.</p>
			</header>

			<section class="blog-list" aria-label="Blog posts">
				{blogPosts.map((post) => (
					<article class="blog-post">
						<h2>
							<a href={post.slug} data-astro-prefetch>{post.title}</a>
						</h2>
						<p>{post.description}</p>
						{post.date && (
							<p class="blog-post-date">{post.date}</p>
						)}
					</article>
				))}
			</section>

			{blogPosts.length === 0 && (
				<p class="blog-empty">No posts yet. Check back soon.</p>
			)}
		</div>
	</div>
</BlogLayout>

<style>
	.blog-page {
		min-height: 100vh;
		padding: 4rem 1.25rem 6rem;
	}

	.blog {
		max-width: 40rem;
		margin: 0 auto;
		font-family: var(--font-lato);
		color: var(--color-primary);
		font-size: 1rem;
		line-height: 1.65;
		font-weight: 400;
	}

	.blog-header {
		margin-bottom: 3rem;
	}

	.blog-label {
		margin: 0 0 0.5rem;
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.blog-intro {
		margin: 0;
		font-size: 1rem;
		font-weight: 400;
		color: var(--color-muted);
	}

	.blog-list {
		margin: 0;
		padding: 0;
	}

	.blog-post {
		margin: 0 0 2.25rem;
		padding: 0;
	}

	.blog-post:last-child {
		margin-bottom: 0;
	}

	.blog-post h2 {
		margin: 0 0 0.25rem;
		font-family: var(--font-lato);
		font-size: 1.0625rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.35;
	}

	.blog-post h2 a {
		color: var(--color-primary);
		text-decoration: none;
		text-decoration-color: color-mix(in srgb, var(--color-muted) 45%, transparent);
		text-underline-offset: 0.2em;
	}

	.blog-post h2 a:hover {
		text-decoration: underline;
	}

	.blog-post p {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--color-muted);
	}

	.blog-post-date {
		margin-top: 0.35rem !important;
		font-size: 0.8125rem !important;
	}

	.blog-empty {
		margin: 0;
		font-size: 0.9375rem;
		color: var(--color-muted);
	}

	@media (min-width: 640px) {
		.blog-page {
			padding: 5.5rem 1.5rem 7rem;
		}
	}
</style>
