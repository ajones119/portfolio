---
import Layout from '../layouts/Layout.astro';
import TicTacToe from '../components/TicTacToe/TicTacToe';
---

<Layout
  title="Tic-Tac-Toe — Aramis Jones"
  description="A thoughtful, responsive game of Tic-Tac-Toe. Play X against an AI opponent on boards from 3×3 through 10×10."
>
  <section class="tic-tac-toe-page" aria-label="Tic-Tac-Toe game">
    <TicTacToe client:load />
  </section>
</Layout>

<style is:global>
  .tic-tac-toe {
    --game-ink: var(--color-primary);
    --game-paper: var(--color-background);
    --game-line: color-mix(in srgb, var(--color-primary) 22%, transparent);
    --game-soft-line: color-mix(in srgb, var(--color-primary) 12%, transparent);
    --game-x: var(--color-secondary);
    --game-o: var(--color-tertiary);
    width: min(100%, 72rem);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4.5rem) clamp(1rem, 4vw, 2.5rem) 5rem;
    color: var(--game-ink);
  }

  .gameHeader { max-width: 41rem; margin-bottom: clamp(2.25rem, 5vw, 4rem); }
  .eyebrow { margin: 0 0 0.7rem; color: var(--color-secondary); font-size: 0.68rem; font-weight: 800; letter-spacing: 0.18em; line-height: 1.2; text-transform: uppercase; }
  .gameHeader h1 { margin: 0; font-family: var(--font-heading); font-size: clamp(3.1rem, 8vw, 6.8rem); font-weight: 400; letter-spacing: -0.045em; line-height: 0.94; }
  .intro { max-width: 31rem; margin: 1.4rem 0 0; color: var(--color-muted); font-size: clamp(1rem, 1.5vw, 1.15rem); line-height: 1.6; }
  .intro strong { color: var(--game-ink); }
  .gameToolbar { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.2rem; padding-bottom: 0.85rem; border-bottom: 1px solid var(--game-line); }
  .gameControls { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .sizeControl { display: grid; gap: 0.35rem; color: var(--color-muted); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .sizeControl select { min-width: 7.2rem; padding: 0.6rem 2rem 0.6rem 0.65rem; border: 1px solid var(--game-line); border-radius: 0; background: var(--game-paper); color: var(--game-ink); font: inherit; font-size: 0.8rem; letter-spacing: 0.02em; text-transform: none; }
  .sizeControl select:focus-visible, .newGameButton:focus-visible, .cell:focus-visible { outline: 3px solid var(--color-tertiary); outline-offset: 3px; }
  .newGameButton { border: 0; border-bottom: 2px solid var(--game-ink); padding: 0.65rem 0.15rem 0.35rem; background: transparent; color: var(--game-ink); cursor: pointer; font: inherit; font-size: 0.84rem; font-weight: 800; transition: color 140ms ease, border-color 140ms ease, transform 140ms ease; }
  .newGameButton:hover { color: var(--color-secondary); border-color: var(--color-secondary); }
  .newGameButton:active { transform: scale(0.97); }
  .gameLayout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(13rem, 18rem); gap: clamp(2rem, 7vw, 6rem); align-items: start; }
  .boardColumn { min-width: 0; }
  .boardMeta { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; align-items: center; margin-bottom: 0.8rem; color: var(--color-muted); font-size: 0.76rem; }
  .playerKey { display: inline-flex; align-items: center; gap: 0.4rem; }
  .playerDot { width: 0.48rem; height: 0.48rem; border-radius: 50%; background: var(--game-x); }
  .playerDotO { background: var(--game-o); }
  .board { width: min(100%, 38rem); border: 1px solid var(--game-line); background: var(--game-paper); container-type: inline-size; }
  .boardRow { display: grid; grid-template-columns: repeat(var(--board-size), minmax(0, 1fr)); }
  .cell { position: relative; display: grid; place-items: center; aspect-ratio: 1; min-width: 0; border: 0; border-right: 1px solid var(--game-line); border-bottom: 1px solid var(--game-line); background: transparent; color: var(--game-ink); cursor: pointer; font: inherit; transition: background-color 140ms ease, color 140ms ease, transform 140ms ease; }
  .boardRow:last-child .cell { border-bottom: 0; }
  .cell:last-child { border-right: 0; }
  .cell:disabled { cursor: default; }
  .cell:not(:disabled):active { transform: scale(0.96); }
  @media (hover: hover) and (pointer: fine) { .cell:not(:disabled):hover { background: color-mix(in srgb, var(--color-quaternary) 18%, transparent); } }
  .cellWinning { background: color-mix(in srgb, var(--color-quaternary) 30%, transparent); color: var(--game-ink); }
  .cellMark { display: block; font-family: var(--font-heading); font-size: clamp(1.35rem, 9cqi, 3.8rem); line-height: 1; animation: mark-pop 150ms ease-out both; }
  .cellMarkX { color: var(--game-x); }
  .cellMarkO { color: var(--game-o); }
  .cellWinning .cellMark { animation: winning-pulse 180ms ease-out both; }
  .gameStatus { display: flex; align-items: center; min-height: 2.1rem; gap: 0.55rem; margin: 1rem 0 0; color: var(--game-ink); font-size: 0.9rem; line-height: 1.45; }
  .gameStatusError { color: var(--color-tertiary); }
  .thinkingIndicator { display: inline-flex; gap: 0.2rem; }
  .thinkingIndicator span { width: 0.32rem; height: 0.32rem; border-radius: 50%; background: var(--color-secondary); animation: thinking-dot 800ms ease-in-out infinite; }
  .thinkingIndicator span:nth-child(2) { animation-delay: 120ms; }
  .thinkingIndicator span:nth-child(3) { animation-delay: 240ms; }
  .historyPanel { padding-top: 0.25rem; border-top: 2px solid var(--game-ink); }
  .historyHeading { padding: 1rem 0 0.7rem; border-bottom: 1px solid var(--game-line); }
  .historyHeading h2 { margin: 0; font-family: var(--font-serif); font-size: clamp(1.35rem, 2.5vw, 1.9rem); font-weight: 500; }
  .moveHistory { list-style: none; margin: 0; padding: 0; }
  .moveHistory li { display: grid; grid-template-columns: 1.5rem 1fr auto; align-items: center; gap: 0.6rem; padding: 0.75rem 0; border-bottom: 1px solid var(--game-soft-line); color: var(--color-muted); font-size: 0.82rem; }
  .historyMark { display: grid; place-items: center; width: 1.5rem; height: 1.5rem; border: 1px solid currentColor; font-family: var(--font-heading); font-size: 0.8rem; line-height: 1; }
  .historyMarkX { color: var(--game-x); }
  .historyMarkO { color: var(--game-o); }
  .moveNumber { color: var(--color-muted); font-size: 0.66rem; letter-spacing: 0.08em; }
  .historyEmpty { margin: 1rem 0; color: var(--color-muted); font-family: var(--font-serif); font-size: 1rem; font-style: italic; line-height: 1.5; }
  @keyframes mark-pop { from { opacity: 0; transform: scale(0.65); } to { opacity: 1; transform: scale(1); } }
  @keyframes winning-pulse { from { opacity: 0.65; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
  @keyframes thinking-dot { 0%, 100% { opacity: 0.3; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-2px); } }
  @media (max-width: 700px) { .gameLayout { grid-template-columns: 1fr; gap: 2.75rem; } .board { width: 100%; } .historyPanel { max-width: none; } }
  @media (max-width: 380px) { .tic-tac-toe { padding-inline: 0.75rem; } .gameToolbar { align-items: start; } .boardMeta { gap: 0.5rem 0.85rem; font-size: 0.7rem; } }
  @media (prefers-reduced-motion: reduce) { .newGameButton, .cell { transition: color 100ms ease, background-color 100ms ease, border-color 100ms ease; } .newGameButton:active, .cell:not(:disabled):active { transform: none; } .cellMark, .cellWinning .cellMark, .thinkingIndicator span { animation: none; } }
</style>
