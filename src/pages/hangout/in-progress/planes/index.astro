---
import Layout from '../../../../layouts/Layout.astro';
---
<Layout title="Jelly Canyon Dogfight • Aramis Jones" description="A realtime comic-western multiplayer dogfight">
  <section class="hangout" aria-label="Jelly Canyon multiplayer dogfight">
    <canvas class="hangout-canvas" aria-label="Three-dimensional multiplayer dogfight"></canvas>
    <div class="halftone" aria-hidden="true"></div><div data-effects-layer class="effects-layer" aria-hidden="true"></div>
    <div class="reticle" aria-hidden="true"><i></i><b></b><i></i><span class="steering-anchor"></span><span class="steering-cue"></span></div>

    <header class="masthead"><span>Jelly Canyon</span><strong>Air Circus</strong><em>unscored free flight</em></header>
    <aside class="player-panel" aria-label="Pilot and online players">
      <label for="hangout-username">Call sign</label>
      <input id="hangout-username" data-username-input type="text" minlength="2" maxlength="24" autocomplete="off" spellcheck="false" />
      <p data-name-error aria-live="polite"></p>
      <div class="roster-heading"><strong>Pilots</strong><span data-player-count>0 / 8</span></div>
      <ul data-player-roster></ul>
      <small><kbd>WASD</kbd> steer · hold <kbd>RMB</kbd> mouse steer · <kbd>LMB</kbd> splat · <kbd>Space</kbd> evade · <kbd>Esc</kbd> setup</small>
    </aside>

    <aside class="combat-hud" data-combat-hud aria-label="Aircraft status">
      <div class="meter"><header><span>Hull jelly</span><b data-health-value>100</b></header><div><i data-health-fill></i></div></div>
      <strong data-flight-state>CONNECTING</strong>
      <div class="meter heat"><header><span>Gun heat</span><b data-heat-value>0%</b></header><div><i data-heat-fill></i></div></div>
      <div class="cooldowns"><span>Boost <b data-boost-cooldown>READY</b></span><span>Evade <b data-evade-cooldown>READY</b></span></div>
    </aside>

    <aside class="settings-panel" data-settings-panel hidden aria-label="Flight settings">
      <header><p>Hangar clipboard</p><h2>Flight setup</h2><span>Your plane keeps gliding—and stays vulnerable.</span></header>
      <div class="settings-scroll"><section><h3>Bindings</h3><div class="bindings" data-bindings-list></div></section>
        <section class="settings-grid"><h3>Feel & visibility</h3>
          <label>Mouse sensitivity <input data-sensitivity type="range" min="0.25" max="2" step="0.05" value="1" /></label>
          <label>Camera shake <input data-cameraShake type="range" min="0" max="1" step="0.05" value=".55" /></label>
          <label><input data-invert-y type="checkbox" /> Invert guided pitch</label><label><input data-reduced-motion type="checkbox" /> Reduce motion & effects</label>
          <label>Reticle <select data-reticle><option value="dynamic">Dynamic</option><option value="fixed">Fixed</option></select></label>
        </section><section class="settings-grid"><h3>Audio</h3>
          <label>Master <input data-masterVolume type="range" min="0" max="1" step="0.05" /></label><label>Effects <input data-effectsVolume type="range" min="0" max="1" step="0.05" /></label><label>Engine <input data-engineVolume type="range" min="0" max="1" step="0.05" /></label>
        </section><section><h3>Coming later</h3><p class="future">More aircraft · Gamepad pilot · Touch controls</p></section></div>
      <footer><button data-reset-settings type="button">Reset defaults</button><small><kbd>Escape</kbd> return to flight</small></footer>
    </aside>

    <aside class="hangout-status" aria-live="polite"><span class="status-dot"></span><strong data-connection-status data-status="connecting">Connecting…</strong><span>Public canyon</span><small data-performance>measuring performance…</small></aside>
    <div class="desktop-required"><strong>Desktop pilots only</strong><p>Jelly Canyon needs a keyboard and mouse. Come back on a desktop browser to fly.</p></div>
  </section>
  <script src="../../../../game/planes/main.ts"></script>
</Layout>

<style>
  :root{--ink:#281922;--paper:#fff0bd;--rust:#a74232;--sun:#efbd3f;--sky:#79c7d7;--jelly:#ed6b98;--mint:#78c578}
  :global(body:has(.hangout)>div.relative){display:none}
  .hangout{position:fixed;inset:0;overflow:hidden;color:var(--paper);background:#6fbaca;font-family:"Trebuchet MS",system-ui,sans-serif}.hangout-canvas{display:block;width:100%;height:100%}.halftone{position:absolute;inset:0;pointer-events:none;opacity:.11;background-image:radial-gradient(var(--ink) .7px,transparent .8px);background-size:5px 5px;mix-blend-mode:multiply}.effects-layer{position:absolute;inset:0;z-index:8;overflow:hidden;pointer-events:none}.hangout[data-flight-status="frozen"]:after{content:"BRRRR!";position:absolute;inset:0;z-index:7;display:grid;place-items:center;background:radial-gradient(circle,transparent 35%,rgb(205 246 255/.48));color:#dffaff;font:900 clamp(2rem,7vw,6rem) Georgia,serif;-webkit-text-stroke:2px #356b78;text-shadow:4px 4px 0 #fff;pointer-events:none}.hangout[data-overheated] .reticle{filter:sepia(1) saturate(4);animation:heatPulse .35s steps(2) infinite}@keyframes heatPulse{50%{scale:1.12}}
  .masthead{position:absolute;top:1rem;left:50%;z-index:3;display:flex;flex-direction:column;align-items:center;transform:translateX(-50%) rotate(-1deg);text-align:center;text-shadow:3px 3px 0 var(--ink)}.masthead span,.masthead em{font:900 .62rem/1 system-ui;text-transform:uppercase;letter-spacing:.2em}.masthead strong{font:900 clamp(1.6rem,3vw,2.8rem)/.9 Georgia,serif;color:var(--sun);text-transform:uppercase}.masthead em{margin-top:.35rem;color:#fff;font-style:normal}
  .player-panel,.hangout-status,.settings-panel{position:absolute;z-index:5;border:3px solid var(--ink);background:color-mix(in srgb,var(--paper) 92%,transparent);color:var(--ink);box-shadow:5px 6px 0 color-mix(in srgb,var(--ink) 85%,transparent)}.player-panel{top:1rem;left:1rem;width:min(14rem,calc(100vw - 2rem));padding:.8rem;transform:rotate(-.4deg)}.player-panel>label,.roster-heading strong{font:900 .64rem/1 system-ui;text-transform:uppercase;letter-spacing:.13em}.player-panel input{box-sizing:border-box;width:100%;margin-top:.35rem;border:2px solid var(--ink);padding:.52rem .6rem;background:#fff9df;color:var(--ink);font-weight:900;outline:none}.player-panel input:focus{box-shadow:0 0 0 3px var(--sun)}[data-name-error]{min-height:1em;margin:.25rem 0;color:var(--rust);font-size:.65rem}.roster-heading{display:flex;justify-content:space-between;margin-top:.55rem;border-top:2px dashed color-mix(in srgb,var(--ink) 35%,transparent);padding-top:.55rem}[data-player-roster]{display:grid;gap:.3rem;margin:.45rem 0;padding:0;list-style:none}[data-player-roster] :global(li){display:flex;align-items:center;gap:.4rem;font-size:.72rem;font-weight:800}[data-player-roster] :global(.roster-dot){width:.65rem;height:.65rem;border:2px solid var(--ink);border-radius:50%}.player-panel small{font-size:.62rem;line-height:1.4}kbd{border:1px solid var(--ink);padding:.05rem .2rem;background:#fff;font:800 .62rem system-ui}
  .hangout-status{top:1rem;right:1rem;display:grid;grid-template-columns:auto auto;gap:.1rem .45rem;padding:.6rem .75rem;font-size:.7rem;transform:rotate(.5deg)}.hangout-status>span:last-of-type{grid-column:2}.hangout-status small{grid-column:1/-1;margin-top:.25rem;border-top:1px solid #8d7964;padding-top:.25rem;font:700 .55rem/1 monospace;color:#65504a}.status-dot{grid-row:1/3;width:.6rem;height:.6rem;margin:auto;border:2px solid var(--ink);border-radius:50%;background:var(--sun)}.hangout-status:has([data-status="connected"]) .status-dot{background:var(--mint)}.hangout-status:has([data-status="failed"],[data-status="full"]) .status-dot{background:#e24d45}
  .reticle{--guide-x:0px;--guide-y:0px;position:absolute;top:50%;left:50%;z-index:3;display:flex;align-items:center;gap:.55rem;transform:translate(-50%,-50%);pointer-events:none}.reticle i{display:block;width:1.2rem;border-top:3px solid var(--paper);filter:drop-shadow(2px 2px 0 var(--ink))}.reticle i:first-child{transform:rotate(8deg)}.reticle i:last-of-type{transform:rotate(-8deg)}.reticle b{width:.42rem;height:.42rem;border:3px solid var(--paper);border-radius:50%;filter:drop-shadow(2px 2px 0 var(--ink))}.steering-anchor,.steering-cue{position:absolute;top:50%;left:50%;display:none;border:2px solid var(--paper);border-radius:50%;box-shadow:2px 2px 0 var(--ink);translate:-50% -50%}.reticle[data-guided] .steering-anchor,.reticle[data-guided] .steering-cue{display:block}.steering-anchor{width:.48rem;height:.48rem;background:#e12f2f}.steering-cue{width:.72rem;height:.72rem;background:color-mix(in srgb,var(--sun) 85%,transparent);transform:translate(var(--guide-x),var(--guide-y));transition:transform 35ms linear}
  .combat-hud{position:absolute;bottom:1rem;left:50%;z-index:4;display:grid;grid-template-columns:minmax(7rem,13rem) auto minmax(7rem,13rem);align-items:end;gap:.65rem;width:min(42rem,calc(100vw - 2rem));transform:translateX(-50%);color:var(--paper);filter:drop-shadow(3px 4px 0 var(--ink));pointer-events:none}.meter header{display:flex;justify-content:space-between;font:900 .62rem/1 system-ui;text-transform:uppercase;letter-spacing:.08em}.meter>div{height:.7rem;margin-top:.25rem;border:3px solid var(--paper);transform:skewX(-12deg);background:var(--ink)}.meter i{display:block;width:100%;height:100%;background:var(--mint);transition:width .15s}.meter.heat i{width:0;background:var(--jelly)}[data-flight-state]{align-self:center;padding:.4rem .7rem;border:3px solid var(--ink);background:var(--sun);color:var(--ink);font:900 .72rem/1 system-ui;text-align:center;transform:rotate(-1deg)}.cooldowns{position:absolute;bottom:2.15rem;left:50%;display:flex;gap:.65rem;transform:translateX(-50%);font:800 .55rem/1 system-ui;text-transform:uppercase;white-space:nowrap}.cooldowns b{color:var(--sun)}
  .settings-panel{top:50%;left:50%;z-index:20;width:min(42rem,calc(100vw - 2rem));max-height:min(44rem,calc(100vh - 2rem));transform:translate(-50%,-50%) rotate(-.25deg)}.settings-panel[hidden]{display:none}.settings-panel header,.settings-panel footer{padding:1rem 1.2rem;background:var(--sun)}.settings-panel header p,.settings-panel header h2,.settings-panel header span{margin:0}.settings-panel header p,.settings-panel h3{font:900 .62rem/1 system-ui;text-transform:uppercase;letter-spacing:.16em}.settings-panel header h2{font:900 2rem/1 Georgia,serif;text-transform:uppercase}.settings-panel header span{font-size:.72rem}.settings-scroll{max-height:calc(100vh - 14rem);overflow:auto;padding:.8rem 1.2rem}.settings-scroll section{border-bottom:2px dashed #9b8065;padding:.7rem 0}.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:.6rem 1rem}.settings-grid h3{grid-column:1/-1}.settings-panel label{display:flex;align-items:center;justify-content:space-between;gap:.6rem;font-size:.75rem;font-weight:800}.bindings{display:grid;grid-template-columns:repeat(2,1fr);gap:.3rem}.bindings :global(button),.settings-panel button{border:2px solid var(--ink);padding:.45rem;background:#fff9df;color:var(--ink);font:800 .68rem system-ui;text-align:left}.settings-panel footer{display:flex;justify-content:space-between;align-items:center}.future{margin:.4rem 0;color:#745c4f;font-size:.75rem}
  :global(.comic-burst){position:absolute;transform:translate(-50%,-50%) rotate(-7deg);padding:.65rem;color:var(--burst-color);font:900 clamp(1.5rem,4vw,3.5rem)/1 Georgia,serif;-webkit-text-stroke:2px var(--ink);text-shadow:4px 4px 0 var(--paper);animation:burst .85s cubic-bezier(.15,.8,.2,1) forwards}:global(.comic-burst:before){content:"";position:absolute;inset:-1rem;z-index:-1;background:var(--sun);clip-path:polygon(50% 0,59% 30%,82% 10%,75% 38%,100% 40%,77% 55%,94% 80%,65% 69%,58% 100%,46% 72%,19% 94%,31% 62%,0 53%,31% 43%,12% 15%,42% 31%)}:global(.comic-burst.is-reduced){animation:fade .35s linear forwards}:global(.comic-burst.is-reduced:before){display:none}@keyframes burst{0%{opacity:0;scale:.35;rotate:-15deg}30%{opacity:1;scale:1.15}100%{opacity:0;scale:1;translate:0 -2rem}}@keyframes fade{to{opacity:0}}
  .desktop-required{display:none}.desktop-required strong{font:900 2rem Georgia,serif;text-transform:uppercase}.desktop-required p{max-width:24rem}
  @media(max-width:48rem),(pointer:coarse){.hangout-canvas,.halftone,.player-panel,.combat-hud,.reticle,.masthead,.hangout-status{display:none}.desktop-required{position:absolute;inset:0;display:grid;place-content:center;padding:2rem;background:var(--sky);color:var(--ink);text-align:center}.desktop-required:before{content:"✦";font-size:4rem;color:var(--sun);-webkit-text-stroke:2px var(--ink)}}
  @media(prefers-reduced-motion:reduce){:global(.comic-burst){animation:fade .35s linear forwards}.meter i{transition:none}}
</style>
