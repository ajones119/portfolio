---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resume • Aramis Jones" description="Professional resume and experience" consoleMessage="Woah! who's this cool guy?">
	<div class="resume-page">
		<div class="resume">
			<header class="resume-header">
				<h1>Aramis Jones</h1>
				<p class="resume-role">Staff Software Engineer</p>
			</header>

			<section class="resume-section">
				<h2>Experience</h2>

				<article class="resume-job">
					<div class="resume-job-head">
						<div>
							<h3>Boston Dynamics</h3>
							<p class="resume-job-title">Staff Software Engineer</p>
						</div>
						<p class="resume-dates">Mar 2026 – Present</p>
					</div>
					<ul>
						<li>Building the Stretch Web Interface with Three.js for real-time 3D visualization of robot state and layout</li>
						<li>Working with the cloud team on over-the-air infrastructure for fleet software updates</li>
						<li>Contributing to agentic flows for operational workflows</li>
						<li>Contributing to a shared React component library</li>
					</ul>
					<p class="resume-tech">React, Three.js, Express, Bazel</p>
				</article>

				<article class="resume-job">
					<div class="resume-job-head">
						<div>
							<h3>PerformYard</h3>
							<p class="resume-job-title">React Guild Lead</p>
						</div>
						<p class="resume-dates">Jan 2023 – Mar 2026</p>
					</div>
					<ul>
						<li>Led client-side technical direction with a committee of designers and engineers</li>
						<li>Built and maintained a React component library on ShadCN and an atomic design system</li>
						<li>Built a Zod form system that cut boilerplate and improved accessibility across pages</li>
						<li>Raised client unit test coverage from 10% to 60% (Vitest, RTL), with tooling for new pages</li>
						<li>Led React upgrades from 15 to 18, then 18 to 19, across legacy surfaces</li>
						<li>Migrated several Tornado Python endpoints to Fastify TypeScript</li>
					</ul>
					<p class="resume-tech">TypeScript, React, Fastify, Python, Zod, TanStack, MongoDB, Vitest</p>
				</article>

				<article class="resume-job">
					<div class="resume-job-head">
						<div>
							<h3>Paycom</h3>
							<p class="resume-job-title">Software Engineer</p>
						</div>
						<p class="resume-dates">May 2021 – Jan 2023</p>
					</div>
					<ul>
						<li>Maintained a React and Redux SPA for employee scheduling and labor calculations against a PHP REST API</li>
						<li>Built and maintained REST APIs in an internal PHP ecosystem</li>
						<li>Added unit testing in React (Jest) and PHP for the Scheduling module</li>
						<li>Code owner for a React codebase on new projects</li>
						<li>Improved performance in legacy PHP by up to 80%</li>
					</ul>
					<p class="resume-tech">React, Redux, PHP, Jest, PHPUnit</p>
				</article>
			</section>

			<section class="resume-section">
				<h2>Freelance</h2>

				<article class="resume-job resume-freelance">
					<div class="resume-job-head">
						<div>
							<h3>
								<a href="https://alchemybarok.com/" target="_blank" rel="noopener noreferrer">Alchemy</a>
							</h3>
							<p class="resume-job-title">Local bar in Edmond, OK</p>
						</div>
					</div>
					<p class="resume-one-liner">Built and maintain the site. Astro, anime.js.</p>
				</article>

				<article class="resume-job resume-freelance">
					<div class="resume-job-head">
						<div>
							<h3>
								<a href="https://www.smileloc.com/" target="_blank" rel="noopener noreferrer">Smileloc</a>
							</h3>
							<p class="resume-job-title">Dental implant company</p>
						</div>
					</div>
					<p class="resume-one-liner">Built and maintain the site. Astro, GSAP.</p>
				</article>
			</section>

			<section class="resume-section">
				<h2>Tech</h2>
				<div class="resume-tech-grid">
					<div>
						<p class="resume-tech-label">Languages</p>
						<p>TypeScript, JavaScript, Python, Golang, HTML, CSS</p>
					</div>
					<div>
						<p class="resume-tech-label">Frameworks</p>
						<p>React, Astro, Three.js, Fastify, Tornado, Mastra</p>
					</div>
					<div>
						<p class="resume-tech-label">Data</p>
						<p>SQL, MongoDB, Firebase</p>
					</div>
					<div>
						<p class="resume-tech-label">Testing</p>
						<p>Vitest, Jest, React Testing Library, PHPUnit</p>
					</div>
					<div>
						<p class="resume-tech-label">Other</p>
						<p>Node.js, Bazel, Zod, Zustand, Redux, Tailwind, ShadCN, AWS Lambda, Supabase</p>
					</div>
				</div>
			</section>

			<section class="resume-section">
				<h2>Education</h2>
				<article class="resume-job">
					<div class="resume-job-head">
						<div>
							<h3>University of Central Oklahoma</h3>
							<p class="resume-job-title">Bachelor's in Software Engineering</p>
						</div>
						<p class="resume-dates">2017 – 2021</p>
					</div>
				</article>
			</section>
		</div>
	</div>
</Layout>

<style>
	.resume-page {
		min-height: 100vh;
		padding: 4rem 1.25rem 6rem;
	}

	.resume {
		max-width: 40rem;
		margin: 0 auto;
		font-family: var(--font-lato);
		color: var(--color-primary);
		font-size: 1rem;
		line-height: 1.65;
		font-weight: 400;
	}

	.resume-header {
		margin-bottom: 4rem;
	}

	.resume-header h1 {
		font-family: var(--font-lato);
		font-size: clamp(1.75rem, 4vw, 2.25rem);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.2;
		margin: 0 0 0.35rem;
		color: var(--color-primary);
	}

	.resume-role {
		margin: 0;
		font-size: 1rem;
		font-weight: 400;
		color: var(--color-muted);
	}

	.resume-section {
		margin-bottom: 3.5rem;
	}

	.resume-section h2 {
		font-family: var(--font-lato);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin: 0 0 1.75rem;
		padding: 0;
		border: none;
	}

	.resume-job {
		margin-bottom: 2.75rem;
		padding: 0;
		border: none;
	}

	.resume-job:last-child {
		margin-bottom: 0;
	}

	.resume-freelance {
		margin-bottom: 2rem;
	}

	.resume-job-head {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin-bottom: 0.85rem;
	}

	.resume-job h3 {
		font-family: var(--font-lato);
		font-size: 1.0625rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		margin: 0;
		color: var(--color-primary);
	}

	.resume-job h3 a {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--color-muted) 45%, transparent);
		text-underline-offset: 0.2em;
	}

	.resume-job h3 a:hover {
		text-decoration-color: var(--color-primary);
	}

	.resume-job-title {
		margin: 0.15rem 0 0;
		font-size: 0.9375rem;
		font-weight: 400;
		color: var(--color-muted);
	}

	.resume-dates {
		margin: 0;
		font-size: 0.875rem;
		font-weight: 400;
		font-style: normal;
		color: var(--color-muted);
	}

	.resume-job ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.resume-job li {
		position: relative;
		padding-left: 1rem;
		margin-bottom: 0.55rem;
		font-size: 0.975rem;
		line-height: 1.6;
		color: var(--color-primary);
	}

	.resume-job li::before {
		content: "–";
		position: absolute;
		left: 0;
		color: var(--color-muted);
	}

	.resume-tech {
		margin: 0.9rem 0 0;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--color-muted);
	}

	.resume-one-liner {
		margin: 0;
		font-size: 0.975rem;
		line-height: 1.6;
		color: var(--color-primary);
	}

	.resume-tech-grid {
		display: grid;
		gap: 1.25rem;
	}

	.resume-tech-label {
		margin: 0 0 0.2rem;
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--color-muted);
	}

	.resume-tech-grid p:not(.resume-tech-label) {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--color-primary);
	}

	@media (min-width: 640px) {
		.resume-page {
			padding: 5.5rem 1.5rem 7rem;
		}

		.resume-job-head {
			flex-direction: row;
			align-items: baseline;
			justify-content: space-between;
			gap: 1.5rem;
		}

		.resume-dates {
			flex-shrink: 0;
			text-align: right;
		}

		.resume-tech-grid {
			grid-template-columns: 1fr 1fr;
			gap: 1.5rem 2rem;
		}

		.resume-tech-grid > :last-child:nth-child(odd) {
			grid-column: 1 / -1;
		}
	}

	@media print {
		.resume-page {
			padding: 0;
		}

		.resume-job {
			break-inside: avoid;
		}

		.resume-job h3 a {
			text-decoration: none;
		}
	}

</style>
