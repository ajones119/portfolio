---
import Tile from './components/tile.astro';
import { experienceJobs, experienceJobsByRecency } from './experience-jobs';
---

<div id="experience-card" class="experience-card">
	<div class="experience-list" data-experience-list>
		<p class="experience-list-label">Experience</p>
		<ul class="experience-list-items">
			{experienceJobsByRecency.map((job) => (
				<li class="experience-list-item" data-experience-list-item style={`--accent: var(--color-${job.accent});`}>
					<p class="experience-list-company">{job.company}</p>
					<p class="experience-list-meta">
						<span>{job.title}</span>
						<span class="experience-list-dot" aria-hidden="true">·</span>
						<span class="experience-list-dates">{job.dates}</span>
					</p>
				</li>
			))}
		</ul>
		<a href="/resume" data-astro-prefetch class="experience-list-link">Full resume →</a>
	</div>

	<div class="experience-stack" data-experience-stack>
		{experienceJobs.map((job) => (
			<Tile {...job} />
		))}
	</div>
</div>

<style>
	.experience-card {
		position: relative;
		width: 100%;
		height: 100%;
	}

	/* Mobile: Emil-style list */
	.experience-list {
		padding: 1.25rem 1rem 1.5rem;
	}

	.experience-list-label {
		margin: 0 0 1.25rem;
		font-family: var(--font-lato);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.experience-list-items {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.experience-list-item {
		position: relative;
		padding: 0 0 0 0.65rem;
		margin-bottom: 1.35rem;
		border-left: 2px solid var(--accent);
	}

	.experience-list-item:last-child {
		margin-bottom: 1rem;
	}

	.experience-list-company {
		margin: 0 0 0.2rem;
		font-family: var(--font-lato);
		font-size: 0.9375rem;
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: -0.01em;
		color: var(--color-primary);
	}

	.experience-list-meta {
		margin: 0;
		font-family: var(--font-lato);
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--color-muted);
	}

	.experience-list-dot {
		margin: 0 0.2rem;
	}

	.experience-list-link {
		font-family: var(--font-lato);
		font-size: 0.8125rem;
		color: var(--color-secondary);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.experience-list-link:hover {
		color: var(--color-primary);
	}

	.experience-stack {
		display: none;
	}

	/* Desktop: fanned card stack */
	@media (min-width: 1024px) {
		.experience-card {
			min-height: 100%;
			overflow: hidden;
		}

		.experience-list {
			display: none;
		}

		.experience-stack {
			display: block;
			position: relative;
			width: 100%;
			height: 100%;
			min-height: 100%;
			perspective: 900px;
		}
	}
</style>

<script>
	import { initExperienceCards } from './Experience';

	initExperienceCards();
</script>
