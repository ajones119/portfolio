<canvas class="distraction-canvas" id="distraction-canvas"></canvas>
<div id="exit-progress" aria-hidden="true"></div>

<style is:global>
  html.distraction-page,
  html.distraction-page body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #050508;
    touch-action: none;
    user-select: none;
  }

  html.distraction-page body {
    outline: none;
  }

  .distraction-canvas {
    display: block;
    width: 100vw;
    height: 100vh;
    cursor: none;
  }

  #exit-progress {
    position: fixed;
    bottom: 1.25rem;
    right: 1.25rem;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.15);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
    z-index: 10;
  }

  #exit-progress.visible {
    opacity: 1;
  }

  #exit-progress::after {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 3px solid transparent;
    border-top-color: #ff00ff;
    border-right-color: #00ffff;
    transform: rotate(var(--exit-rotate, 0deg));
  }
</style>
